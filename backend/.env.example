# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=pureaircalifornia

# Environment (set to 'production' in production to restrict CORS)
ENVIRONMENT=development

# Admin Authentication (REQUIRED - change this to a strong secret!)
ADMIN_SECRET=your-secure-admin-secret-change-this

# Authentication (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe (Get from https://dashboard.stripe.com/test/apikeys)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid (Email - Get from https://app.sendgrid.com/settings/api_keys)
# SENDGRID_API_KEY=SG....
FROM_EMAIL=noreply@pureaircalifornia.com

# Twilio (SMS - Get from https://console.twilio.com/)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

# AWS S3 (Document Storage)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=pac-documents
AWS_REGION=us-west-2

# Google Places API (Lead Scanner - Get from https://console.cloud.google.com/)
# GOOGLE_PLACES_API_KEY=AIza...

# Email outreach (Lead Scanner). Resend is preferred; get a key at https://resend.com/api-keys
# RESEND_API_KEY=re_...
# Signing secret from Resend > Webhooks (needed for open / bounce tracking)
# RESEND_WEBHOOK_SECRET=whsec_...
# Random string of at least 24 characters. The scheduler sends it as the
# X-Cron-Key header (never in the URL) to POST /api/lead-scanner/outreach/run-drip
# CRON_SECRET=
# Where "new inspection request" alerts are emailed
# OWNER_NOTIFY_EMAIL=
OUTREACH_FROM_EMAIL=lou@pureaircalifornia.com
OUTREACH_FROM_NAME=Lou at Pure Air California
# Required by CAN-SPAM in every outreach email
OUTREACH_POSTAL_ADDRESS=PO Box 3842, Valley Village, CA 91617
# Ceiling on outreach emails per rolling 24 hours
OUTREACH_DAILY_LIMIT=40
PUBLIC_API_URL=https://pac-crm-backend.onrender.com/api
