# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=pureaircalifornia

# Environment (set to 'production' in production to restrict CORS)
ENVIRONMENT=development

# Admin Authentication (REQUIRED - change this to a strong secret!)
ADMIN_SECRET=your-secure-admin-secret-change-this

# Authentication (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe (Get from https://dashboard.stripe.com/test/apikeys)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid (Email - Get from https://app.sendgrid.com/settings/api_keys)
# SENDGRID_API_KEY=SG....
# Resend (preferred if set - Get from https://resend.com/api-keys)
# RESEND_API_KEY=re_...
FROM_EMAIL=noreply@pureaircalifornia.com

# Public base URL of THIS API, used to build one-click unsubscribe links
# (RFC 8058) in outreach emails. Set this in production for best deliverability.
# API_PUBLIC_URL=https://api.pureaircalifornia.com
#
# DELIVERABILITY (DNS — not code): for inbox placement you MUST authenticate the
# sending domain at your DNS provider:
#   1. SPF   — TXT record authorizing Resend/SendGrid to send as pureaircalifornia.com
#   2. DKIM  — CNAME/TXT keys from the Resend/SendGrid dashboard (signs every email)
#   3. DMARC — _dmarc TXT, e.g. "v=DMARC1; p=none; rua=mailto:dmarc@pureaircalifornia.com"
# Gmail/Yahoo (Feb 2024) require SPF+DKIM+DMARC AND one-click unsubscribe for bulk senders.

# Twilio (SMS - Get from https://console.twilio.com/)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

# AWS S3 (Document Storage)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
S3_BUCKET_NAME=pac-documents
AWS_REGION=us-west-2

# Google Places API (Lead Scanner - Get from https://console.cloud.google.com/)
# GOOGLE_PLACES_API_KEY=AIza...
