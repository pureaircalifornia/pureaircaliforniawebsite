{
  "name": "Pure Air California Speed-to-Lead Engine",
  "nodes": [
    {
      "parameters": {
        "path": "website-lead",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "c1f7a8b2-3e4d-4567-89ab-cdef01234567",
      "name": "Website Quote Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 250, 300 ],
      "webhookId": "website-lead-webhook-receiver"
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            { "name": "Name", "value": "={{$json.body.name}}" },
            { "name": "Phone", "value": "={{$json.body.phone}}" },
            { "name": "Email", "value": "={{$json.body.email}}" },
            { "name": "ServiceRequested", "value": "={{$json.body.service}}" },
            { "name": "Address", "value": "={{$json.body.address}}" },
            { "name": "SqFootage", "value": "={{$json.body.squareFootage}}" },
            { "name": "OfferClaimed", "value": "={{$json.body.offer_claimed}}" }
          ]
        },
        "options": {}
      },
      "id": "e2f7a8b2-4f5e-5678-90bc-def012345678",
      "name": "Parse Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [ 450, 300 ]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "ENTER_YOUR_GOOGLE_SHEET_ID_HERE",
        "range": "A:H",
        "options": {}
      },
      "id": "3b2a1c9d-8f7e-6543-2109-fedcba098765",
      "name": "Save to System (Google Sheets CRM)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [ 650, 200 ],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "google_sheets_auth", "name": "Google Sheets account" }
      }
    },
    {
      "parameters": {
        "from": "PAC Leads <pureair@yourdomain.com>",
        "to": "YOUR_CELL_NUMBER@vtext.com", 
        "subject": "🚨 NEW LA LEAD: {{$node[\"Parse Lead Data\"].json[\"ServiceRequested\"]}}",
        "text": "Name: {{$node[\"Parse Lead Data\"].json[\"Name\"]}}\nPhone: {{$node[\"Parse Lead Data\"].json[\"Phone\"]}}\nOffer: {{$node[\"Parse Lead Data\"].json[\"OfferClaimed\"]}}\n\nTap to call now: {{$node[\"Parse Lead Data\"].json[\"Phone\"]}}\nAddress: {{$node[\"Parse Lead Data\"].json[\"Address\"]}}",
        "options": {}
      },
      "id": "4c3b2d1e-9a8b-7052-3210-abcdef123456",
      "name": "SMS Alert Setup (Email-to-SMS)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [ 650, 400 ],
      "notesInFlow": true,
      "notes": "Replace YOUR_CELL_NUMBER@vtext.com with your carrier's text gateway (e.g. 2137924145@vtext.com for Verizon, @txt.att.net for AT&T)"
    }
  ],
  "connections": {
    "Website Quote Form Webhook": {
      "main": [ [ { "node": "Parse Lead Data", "type": "main", "index": 0 } ] ]
    },
    "Parse Lead Data": {
      "main": [
        [ { "node": "Save to System (Google Sheets CRM)", "type": "main", "index": 0 } ],
        [ { "node": "SMS Alert Setup (Email-to-SMS)", "type": "main", "index": 0 } ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Los_Angeles"
  }
}
