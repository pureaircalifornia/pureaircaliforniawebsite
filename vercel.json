{
  "version": 2,
  "buildCommand": "cd frontend && npm ci --no-audit --no-fund && npm run build",
  "outputDirectory": "frontend/build",
  "env": {
    "NODE_VERSION": "20"
  },
  "framework": null,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/residential-air-duct-cleaning",
      "destination": "/services/residential-air-duct-cleaning/",
      "permanent": true
    },
    {
      "source": "/commercial-air-duct-cleaning",
      "destination": "/services/commercial-air-duct-cleaning/",
      "permanent": true
    },
    {
      "source": "/dryer-vent-cleaning",
      "destination": "/services/residential-dryer-vent-cleaning/",
      "permanent": true
    },
    {
      "source": "/air-duct-cleaning",
      "destination": "/services/residential-air-duct-cleaning/",
      "permanent": true
    },
    {
      "source": "/filters",
      "destination": "/services/residential-electrostatic-filter/",
      "permanent": true
    },
    {
      "source": "/services/electrostatic-filter-program",
      "destination": "/services/residential-electrostatic-filter/",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/blog/air-duct-cleaning-faq/",
      "permanent": true
    },
    {
      "source": "/specials",
      "destination": "/pricing/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|llms\\.txt|llms-full\\.txt)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(admin|feedback)(/.*)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/feedback/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
